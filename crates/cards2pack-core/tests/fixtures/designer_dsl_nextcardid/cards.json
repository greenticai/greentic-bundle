          "wrap": true
        },
        {
          "facts": [
            {
              "title": "Q: What is Greentic?",
              "value": "Greentic is a platform for building and deploying intelligent digital workers \u2014 automated agents that handle business processes end-to-end using AI and workflow orchestration."
            },
            {
              "title": "Q: Who uses Greentic?",
              "value": "Teams across operations, customer support, sales, and engineering use Greentic to automate repetitive tasks, reduce manual effort, and ship AI-powered products faster."
            },
            {
              "title": "Q: How do I get started?",
              "value": "You can explore our open-source repository on GitHub or read through the full documentation at docs.greentic.ai to understand the architecture and quickstart guides."
            },
            {
              "title": "Q: Is Greentic free to use?",
              "value": "Greentic has an open-source core. Commercial plans with managed hosting, enterprise support, and SLA guarantees are available \u2014 speak to our team for details."
            }
          ],
          "type": "FactSet"
        }
      ],
      "id": "explorer_info",
      "type": "AdaptiveCard",
      "version": "1.6"
